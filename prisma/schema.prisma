generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String   @id @default(cuid())
  name       String
  age        Int
  photo      String
  bio        String
  city       String
  occupation String?
  interests  String   // JSON array stored as string
  createdAt  DateTime @default(now())

  swipesMade     Swipe[] @relation("SwiperSwipes")
  swipesReceived Swipe[] @relation("TargetSwipes")
  matchesAsUser1 Match[] @relation("MatchUser1")
  matchesAsUser2 Match[] @relation("MatchUser2")
}

model Swipe {
  id        String   @id @default(cuid())
  swiperId  String
  targetId  String
  action    String   // "like" or "pass"
  createdAt DateTime @default(now())

  swiper User @relation("SwiperSwipes", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("TargetSwipes", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([swiperId])
  @@index([targetId])
  @@index([swiperId, targetId, action])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}
